<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>WARDROBE.EXE</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800&family=VT323&display=swap');

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: 'Orbitron', sans-serif;
    color: #111;
    background:
        radial-gradient(circle at 20% 20%, #ffffff 0 2px, transparent 3px),
        radial-gradient(circle at 80% 70%, #ffffff 0 2px, transparent 3px),
        linear-gradient(135deg, #b8f3ff, #f2c7ff 50%, #b9fff0);
    background-size: 80px 80px, 120px 120px, cover;
}

/* ---------- HEADER ---------- */

header {
    padding: 25px;
    text-align: center;
}

.logo {
    display: inline-block;
    padding: 15px 30px;
    border: 3px solid #111;
    border-radius: 18px;
    background: linear-gradient(135deg, #fff, #d7d7d7);
    box-shadow:
        7px 7px 0 #111,
        inset 0 0 15px #fff;
    transform: rotate(-1deg);
}

.logo h1 {
    margin: 0;
    font-size: clamp(28px, 6vw, 55px);
    letter-spacing: 4px;
}

.logo span {
    font-family: 'VT323', monospace;
    font-size: 20px;
}

/* ---------- NAV ---------- */

nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 10px auto 25px;
    flex-wrap: wrap;
}

nav button,
button {
    border: 2px solid #111;
    background: linear-gradient(#fff, #cfcfcf);
    padding: 10px 18px;
    border-radius: 999px;
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 3px 3px 0 #111;
    transition: 0.12s;
}

button:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 #111;
}

button:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 #111;
}

nav button.active {
    background: #ff7bea;
}

/* ---------- MAIN ---------- */

main {
    width: min(1000px, 92%);
    margin: auto;
}

.panel {
    background: rgba(255,255,255,0.82);
    border: 3px solid #111;
    border-radius: 25px;
    padding: 25px;
    box-shadow: 8px 8px 0 #111;
    backdrop-filter: blur(8px);
}

.hidden {
    display: none !important;
}

/* ---------- UPLOAD ---------- */

.upload-box {
    border: 3px dashed #111;
    border-radius: 20px;
    padding: 40px 20px;
    text-align: center;
    background: linear-gradient(
        135deg,
        rgba(255,255,255,.9),
        rgba(255,175,247,.4)
    );
}

.upload-box h2 {
    margin-top: 0;
}

input[type="file"] {
    display: none;
}

.upload-label {
    display: inline-block;
    padding: 14px 25px;
    border: 3px solid #111;
    border-radius: 999px;
    background: #62f6ff;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 5px 5px 0 #111;
}

.upload-label:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 #111;
}

/* ---------- CLOTHING GRID ---------- */

.clothing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 20px;
    margin-top: 25px;
}

.clothing-card {
    background: white;
    border: 3px solid #111;
    border-radius: 18px;
    padding: 10px;
    box-shadow: 5px 5px 0 #111;
}

.clothing-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 12px;
    background: #eee;
}

.card-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 5px;
    margin-top: 8px;
}

.category {
    font-size: 11px;
    background: #ff7bea;
    padding: 5px 8px;
    border-radius: 999px;
    border: 2px solid #111;
}

.delete-btn {
    padding: 5px 8px;
    font-size: 11px;
    box-shadow: 2px 2px 0 #111;
}

/* ---------- SWIPE ---------- */

.swipe-area {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.swipe-card {
    width: min(400px, 90%);
    height: 500px;
    background: white;
    border: 4px solid #111;
    border-radius: 25px;
    box-shadow: 10px 10px 0 #111;
    overflow: hidden;
    position: relative;
    touch-action: none;
    user-select: none;
    cursor: grab;
}

.swipe-card:active {
    cursor: grabbing;
}

.swipe-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: linear-gradient(135deg, #eee, #fff);
}

.swipe-label {
    position: absolute;
    top: 20px;
    padding: 8px 15px;
    border: 3px solid #111;
    border-radius: 10px;
    font-size: 20px;
    font-weight: 800;
    opacity: 0;
}

.like-label {
    right: 20px;
    background: #67ff9c;
    transform: rotate(12deg);
}

.no-label {
    left: 20px;
    background: #ff6b91;
    transform: rotate(-12deg);
}

.swipe-buttons {
    display: flex;
    gap: 20px;
    margin-top: 25px;
}

.nope {
    background: #ff6b91;
}

.like {
    background: #67ff9c;
}

.swipe-empty {
    text-align: center;
    padding: 50px;
}

/* ---------- OUTFIT ---------- */

.outfit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.outfit-slot {
    min-height: 250px;
    border: 3px dashed #111;
    border-radius: 18px;
    padding: 10px;
    text-align: center;
    background: rgba(255,255,255,.7);
}

.outfit-slot img {
    width: 100%;
    height: 220px;
    object-fit: contain;
}

.outfit-slot.empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'VT323', monospace;
    font-size: 25px;
}

.save-outfit {
    margin-top: 25px;
    background: #ffe45c;
}

/* ---------- SAVED OUTFITS ---------- */

.saved-outfit {
    border: 3px solid #111;
    border-radius: 20px;
    padding: 15px;
    margin-bottom: 20px;
    background: white;
    box-shadow: 5px 5px 0 #111;
}

.saved-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.saved-items img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    border: 2px solid #111;
    border-radius: 10px;
}

/* ---------- MOBILE ---------- */

@media(max-width: 600px) {
    .panel {
        padding: 15px;
    }

    .swipe-card {
        height: 420px;
    }

    .saved-items {
        grid-template-columns: repeat(2, 1fr);
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">
        <h1>WARDROBE.EXE</h1>
        <span>✦ fashion operating system v1.0 ✦</span>
    </div>
</header>

<nav>
    <button class="active" onclick="showPage('wardrobe', this)">WARDROBE</button>
    <button onclick="showPage('swipe', this)">SWIPE</button>
    <button onclick="showPage('outfit', this)">FIT BUILDER</button>
    <button onclick="showPage('saved', this)">SAVED FITS</button>
</nav>

<main>

<!-- WARDROBE -->

<section id="wardrobe" class="panel">

    <div class="upload-box">

        <h2>＋ ADD TO WARDROBE</h2>

        <p>
            Upload a picture of something you own.
        </p>

        <label class="upload-label" for="fileInput">
            📸 SELECT PHOTO
        </label>

        <input
            id="fileInput"
            type="file"
            accept="image/*"
            multiple
        >

        <p id="uploadStatus"></p>

    </div>

    <div id="clothingGrid" class="clothing-grid"></div>

</section>


<!-- SWIPE -->

<section id="swipe" class="panel hidden">

    <div class="swipe-area">

        <h2>♡ PICK YOUR PIECES</h2>

        <p>
            Swipe right to wear it. Swipe left to skip it.
        </p>

        <div id="swipeContainer"></div>

    </div>

</section>


<!-- OUTFIT BUILDER -->

<section id="outfit" class="panel hidden">

    <h2>✦ FIT BUILDER</h2>

    <p>
        Your selected pieces:
    </p>

    <div id="outfitContainer" class="outfit"></div>

    <button
        class="save-outfit"
        onclick="saveOutfit()"
    >
        💾 SAVE THIS FIT
    </button>

    <button
        onclick="randomOutfit()"
    >
        🎲 RANDOM FIT
    </button>

</section>


<!-- SAVED -->

<section id="saved" class="panel hidden">

    <h2>♡ SAVED FITS</h2>

    <div id="savedContainer"></div>

</section>

</main>


<script>

/* =========================================
   DATA
========================================= */

let clothes = JSON.parse(
    localStorage.getItem("wardrobe")
) || [];

let savedOutfits = JSON.parse(
    localStorage.getItem("savedOutfits")
) || [];

let selectedItems = [];

let swipeIndex = 0;


/* =========================================
   PAGE NAVIGATION
========================================= */

function showPage(page, button) {

    document.querySelectorAll("main > section")
        .forEach(section => {
            section.classList.add("hidden");
        });

    document.getElementById(page)
        .classList.remove("hidden");

    document.querySelectorAll("nav button")
        .forEach(btn => {
            btn.classList.remove("active");
        });

    button.classList.add("active");

    if (page === "swipe") {
        startSwipe();
    }

    if (page === "outfit") {
        renderOutfit();
    }

    if (page === "saved") {
        renderSaved();
    }
}


/* =========================================
   UPLOAD
========================================= */

document
    .getElementById("fileInput")
    .addEventListener("change", function(event) {

        const files = [...event.target.files];

        files.forEach(file => {

            const reader = new FileReader();

            reader.onload = function(e) {

                const item = {

                    id: Date.now() + Math.random(),

                    image: e.target.result,

                    category: "top"

                };

                clothes.push(item);

                saveData();

                renderWardrobe();

            };

            reader.readAsDataURL(file);

        });

        event.target.value = "";

    });


/* =========================================
   SAVE DATA
========================================= */

function saveData() {

    localStorage.setItem(
        "wardrobe",
        JSON.stringify(clothes)
    );

    localStorage.setItem(
        "savedOutfits",
        JSON.stringify(savedOutfits)
    );

}


/* =========================================
   WARDROBE
========================================= */

function renderWardrobe() {

    const grid =
        document.getElementById("clothingGrid");

    grid.innerHTML = "";

    if (clothes.length === 0) {

        grid.innerHTML = `
            <div style="
                grid-column:1/-1;
                text-align:center;
                padding:40px;
            ">
                <h2>Your wardrobe is empty.</h2>
                <p>Upload some clothes to get started ✦</p>
            </div>
        `;

        return;
    }

    clothes.forEach(item => {

        const card =
            document.createElement("div");

        card.className = "clothing-card";

        card.innerHTML = `

            <img src="${item.image}">

            <div class="card-info">

                <select
                    onchange="changeCategory(${item.id}, this.value)"
                >
                    <option value="top"
                        ${item.category === "top" ? "selected" : ""}>
                        TOP
                    </option>

                    <option value="bottom"
                        ${item.category === "bottom" ? "selected" : ""}>
                        BOTTOM
                    </option>

                    <option value="shoes"
                        ${item.category === "shoes" ? "selected" : ""}>
                        SHOES
                    </option>

                    <option value="outerwear"
                        ${item.category === "outerwear" ? "selected" : ""}>
                        OUTERWEAR
                    </option>

                    <option value="accessory"
                        ${item.category === "accessory" ? "selected" : ""}>
                        ACCESSORY
                    </option>

                </select>

                <button
                    class="delete-btn"
                    onclick="deleteItem(${item.id})"
                >
                    ✕
                </button>

            </div>

        `;

        grid.appendChild(card);

    });

}


function changeCategory(id, category) {

    const item =
        clothes.find(item => item.id === id);

    if (item) {

        item.category = category;

        saveData();

    }

}


function deleteItem(id) {

    clothes =
        clothes.filter(item => item.id !== id);

    selectedItems =
        selectedItems.filter(item => item.id !== id);

    saveData();

    renderWardrobe();

}


/* =========================================
   SWIPE SYSTEM
========================================= */

function startSwipe() {

    swipeIndex = 0;

    renderSwipeCard();

}


function renderSwipeCard() {

    const container =
        document.getElementById("swipeContainer");

    if (swipeIndex >= clothes.length) {

        container.innerHTML = `

            <div class="swipe-empty">

                <h2>✦ ALL DONE ✦</h2>

                <p>
                    You've gone through your wardrobe.
                </p>

                <button onclick="startSwipe()">
                    ↻ START AGAIN
                </button>

                <br><br>

                <button onclick="
                    document.querySelector(
                        'button[onclick*=outfit]'
                    ).click()
                ">
                    BUILD MY FIT →
                </button>

            </div>

        `;

        return;
    }


    const item = clothes[swipeIndex];

    container.innerHTML = `

        <div
            class="swipe-card"
            id="currentCard"
        >

            <img src="${item.image}">

            <div
                class="swipe-label like-label"
                id="likeLabel"
            >
                WEAR IT
            </div>

            <div
                class="swipe-label no-label"
                id="noLabel"
            >
                NAH
            </div>

        </div>

        <div class="swipe-buttons">

            <button
                class="nope"
                onclick="swipe(false)"
            >
                ✕
            </button>

            <button
                class="like"
                onclick="swipe(true)"
            >
                ♥
            </button>

        </div>
    `;


    setupDrag();

}


/* =========================================
   BUTTON SWIPE
========================================= */

function swipe(liked) {

    const item = clothes[swipeIndex];

    if (liked) {

        if (!selectedItems.some(
            selected => selected.id === item.id
        )) {

            selectedItems.push(item);

        }

    }

    swipeIndex++;

    renderSwipeCard();

}


/* =========================================
   DRAGGING
========================================= */

function setupDrag() {

    const card =
        document.getElementById("currentCard");

    if (!card) return;

    let startX = 0;
    let currentX = 0;
    let dragging = false;


    card.addEventListener("pointerdown", e => {

        dragging = true;

        startX = e.clientX;

        card.setPointerCapture(e.pointerId);

    });


    card.addEventListener("pointermove", e => {

        if (!dragging) return;

        currentX =
            e.clientX - startX;

        const rotation =
            currentX / 15;

        card.style.transform =
            `translateX(${currentX}px) rotate(${rotation}deg)`;


        const like =
            document.getElementById("likeLabel");

        const nope =
            document.getElementById("noLabel");


        if (currentX > 0) {

            like.style.opacity =
                Math.min(currentX / 100, 1);

        } else {

            nope.style.opacity =
                Math.min(Math.abs(currentX) / 100, 1);

        }

    });


    card.addEventListener("pointerup", () => {

        dragging = false;

        if (currentX > 120) {

            swipe(true);

        } else if (currentX < -120) {

            swipe(false);

        } else {

            card.style.transform =
                "";

            document.getElementById(
                "likeLabel"
            ).style.opacity = 0;

            document.getElementById(
                "noLabel"
            ).style.opacity = 0;

        }

        currentX = 0;

    });

}


/* =========================================
   OUTFIT BUILDER
========================================= */

function renderOutfit() {

    const container =
        document.getElementById("outfitContainer");

    container.innerHTML = "";


    const categories = [
        "top",
        "bottom",
        "shoes",
        "outerwear",
        "accessory"
    ];


    categories.forEach(category => {

        const item =
            selectedItems.find(
                item => item.category === category
            );


        const slot =
            document.createElement("div");

        slot.className =
            "outfit-slot";


        if (item) {

            slot.innerHTML = `

                <img src="${item.image}">

                <strong>
                    ${category.toUpperCase()}
                </strong>

            `;

        } else {

            slot.classList.add("empty");

            slot.innerHTML =
                `+ ${category.toUpperCase()}`;

        }


        container.appendChild(slot);

    });

}


/* =========================================
   RANDOM FIT
========================================= */

function randomOutfit() {

    selectedItems = [];

    const categories = [
        "top",
        "bottom",
        "shoes",
        "outerwear",
        "accessory"
    ];


    categories.forEach(category => {

        const options =
            clothes.filter(
                item => item.category === category
            );

        if (options.length > 0) {

            const random =
                options[
                    Math.floor(
                        Math.random() *
                        options.length
                    )
                ];

            selectedItems.push(random);

        }

    });


    renderOutfit();

}


/* =========================================
   SAVE OUTFIT
========================================= */

function saveOutfit() {

    if (selectedItems.length === 0) {

        alert(
            "Pick some clothes first!"
        );

        return;

    }


    savedOutfits.push({

        id: Date.now(),

        items: [...selectedItems]

    });


    saveData();

    alert(
        "FIT SAVED ✦"
    );

}


/* =========================================
   SAVED OUTFITS
========================================= */

function renderSaved() {

    const container =
        document.getElementById("savedContainer");

    container.innerHTML = "";


    if (savedOutfits.length === 0) {

        container.innerHTML = `

            <div style="
                text-align:center;
                padding:40px;
            ">

                <h2>No saved fits yet.</h2>

                <p>
                    Build something fire first 🔥
                </p>

            </div>

        `;

        return;

    }


    savedOutfits.forEach((outfit, index) => {

        const div =
            document.createElement("div");

        div.className =
            "saved-outfit";


        div.innerHTML = `

            <h3>
                FIT #${index + 1}
            </h3>

            <div class="saved-items">

                ${outfit.items.map(item => `

                    <img src="${item.image}">

                `).join("")}

            </div>

            <br>

            <button
                onclick="deleteOutfit(${outfit.id})"
            >
                DELETE FIT
            </button>

        `;


        container.appendChild(div);

    });

}


function deleteOutfit(id) {

    savedOutfits =
        savedOutfits.filter(
            outfit => outfit.id !== id
        );

    saveData();

    renderSaved();

}


/* =========================================
   INITIAL LOAD
========================================= */

renderWardrobe();

</script>

</body>
</html>
